# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001
SECRET_KEY=solar-monitoring-super-secret-key-change-in-production
JWT_SECRET_KEY=solar-jwt-secret-key-production-ready-2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration (MySQL 8 or SQLite fallback)
# MySQL format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Default fallback to local sqlite database if MySQL is not running
DATABASE_URL=sqlite:///solar_monitoring.db
# Uncomment below for MySQL 8:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/solar_monitoring

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=solar_monitoring

# External Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# System Defaults
DEFAULT_CURRENCY=₹
DEFAULT_CURRENCY_CODE=INR
POLLING_INTERVAL_SECONDS=15
DEMO_MODE_ENABLED=true
